# 이 파일을 복사해서 .env 로 만들고 실제 키 값을 채워주세요.
# cp .env.example .env

# Gemini API 키 (단어/예문 분석, 번역, 사진 OCR용)
# https://aistudio.google.com/apikey 에서 무료로 발급 (신용카드 등록 불필요)
GEMINI_API_KEY=

# Google Cloud Text-to-Speech API 키 (고품질 중국어 음성 합성용)
# https://console.cloud.google.com/apis/credentials 에서 "API 키 만들기" 후,
# "Cloud Text-to-Speech API"를 사용하도록 키 제한 설정 후 값 복사
GOOGLE_TTS_API_KEY=

# 서버 포트 (기본값 3000)
PORT=3000
